PORT=3001
DEBUG=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ingestion_service
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
JWT_SECRET=change_me_to_a_random_64_char_secret
CORS_ORIGINS=["http://localhost:5173"]

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ingestion-artifacts

ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_SIGNAL_MODEL=claude-haiku-4-5
ANTHROPIC_SIGNAL_EFFORT=low
ANTHROPIC_SYNTHESIS_MODEL=claude-haiku-4-5
ANTHROPIC_SYNTHESIS_EFFORT=medium
ANTHROPIC_SYNTHESIS_RETRY_MODEL=claude-haiku-4-5
ANTHROPIC_SYNTHESIS_RETRY_EFFORT=medium
ANTHROPIC_ENABLE_PROMPT_CACHING=true
VOYAGE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=voyage

SYNTHESIS_CLUSTER_THRESHOLD=0.75
SYNTHESIS_MAX_SIGNALS=2000
SYNTHESIS_AUTO_TRIGGER_MIN=5
SYNTHESIS_CLUSTER_CONCURRENCY=4
SYNTHESIS_RETRY_CONFIDENCE_THRESHOLD=0.65
SYNTHESIS_HIGH_VALUE_SIGNAL_COUNT=6
SYNTHESIS_MAX_REPRESENTATIVE_SIGNALS=5
SYNTHESIS_STALE_RUN_GRACE_SECONDS=45
INGESTION_BATCH_CONCURRENCY=5
# Background loop that polls event_buffers every 60s. Off by default to avoid idle DB usage.
TRIGGER_RUNTIME_ENABLED=false

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

CREDENTIALS_ENCRYPTION_KEY=

# Optional: agent service base URL (no /api/v1 suffix) for chat tools — PRs, jobs, changed files
AGENT_SERVICE_URL=http://localhost:3002
